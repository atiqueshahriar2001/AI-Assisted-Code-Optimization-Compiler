{
  "version": 2,
  "functions": {
    "api/optimize.py": {
      "runtime": "@vercel/python@3.15.0a6"
    }
  },
  "routes": [
    {
      "src": "/optimize",
      "methods": ["POST"],
      "dest": "/api/optimize.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}