{
  "version": 2,
  "builds": [
    {
      "src": "api/optimize.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/optimize",
      "methods": ["POST"],
      "dest": "/api/optimize.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}